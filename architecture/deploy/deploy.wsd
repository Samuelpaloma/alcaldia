@startuml
title Sistema de Gestión de Tickets - Diagrama de Despliegue

' === Nodos de cliente ===
node "Dispositivo del Funcionario" {
  artifact "Navegador Web" as navegadorF
}

node "Dispositivo del Administrador" {
  artifact "Navegador Web" as navegadorA
}

node "Dispositivo del Super Administrador" {
  artifact "Navegador Web" as navegadorSA
}

node "Dispositivo del Técnico" {
  artifact "App Móvil Android" as appMovil
}

' === Nodo Servidor Web / Backend ===
node "Servidor de Aplicaciones" {
  component "Portal Web" as portal
  component "API REST Backend" as api
}

' === Nodo Servidor de Base de Datos ===
node "Servidor de Base de Datos" {
  database "Base de Datos" as db
}

' === Relaciones ===
navegadorF --> portal : HTTPS
navegadorA --> portal : HTTPS
navegadorSA --> portal : HTTPS
appMovil --> api : HTTPS

portal --> api : HTTP interno
api --> db : Conexión JDBC/SQL

@enduml
