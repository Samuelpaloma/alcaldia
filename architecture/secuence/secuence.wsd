@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequence {
  ArrowColor #2E86AB
  LifeLineBackgroundColor #E8F4FD
  LifeLineBorderColor #2E86AB
  ParticipantBackgroundColor #FFE5B4
  ParticipantBorderColor #FF8C00
}

title Sistema de Gestión de Tickets - Diagrama de Secuencia

actor Funcionario
actor Administrador
actor Tecnico
actor SuperAdministrador

participant "Portal Web" as Web
participant "App Móvil" as App
participant "API REST" as API
participant "Servicio Autenticación" as Auth
participant "Servicio Tickets" as TicketSvc
participant "Servicio Notificaciones" as NotifSvc
participant "Base de Datos" as DB
participant "Email Service" as Email
participant "SMS Service" as SMS
participant "IA Engine" as IA

== Autenticación de Usuario ==
Funcionario -> Web: Ingresar credenciales
Web -> API: POST /auth/login
API -> Auth: validarCredenciales(email, password)
Auth -> DB: SELECT usuario WHERE email = ?
DB --> Auth: datos usuario

alt Usuario encontrado
    Auth -> Auth: verificarPassword(password, hash)
    alt Contraseña correcta
        Auth --> API: token JWT + datos usuario
        API -> NotifSvc: enviarNotificacionLogin(usuario)
        NotifSvc -> Email: enviarEmail("Login exitoso")
        Email --> Funcionario: Email de confirmación
        API --> Web: {token, user, role, status: "OK"}
        Web --> Funcionario: Redirigir al dashboard
    else Contraseña incorrecta
        Auth --> API: {error: "Credenciales inválidas", status: "ERROR"}
        API --> Web: {error: "Credenciales inválidas", status: "ERROR"}
        Web --> Funcionario: Mostrar error "Credenciales incorrectas"
    end
else Usuario no encontrado
    DB --> Auth: null
    Auth --> API: {error: "Usuario no existe", status: "ERROR"}
    API --> Web: {error: "Usuario no existe", status: "ERROR"}
    Web --> Funcionario: Mostrar error "Usuario no encontrado"
end

== Creación de Ticket ==
Funcionario -> Web: Completar formulario de ticket
Web -> API: POST /tickets
API -> TicketSvc: crearTicket(datosTicket)

alt Datos válidos
    TicketSvc -> IA: clasificarTicket(titulo, descripcion)
    IA --> TicketSvc: {categoria, prioridad, tecnicoSugerido}
    TicketSvc -> DB: INSERT ticket
    alt Inserción exitosa
        DB --> TicketSvc: ticketId
        TicketSvc -> NotifSvc: notificarNuevoTicket(ticketId)
        NotifSvc -> Email: enviarEmail("Nuevo ticket creado")
        Email --> Administrador: Notificación de nuevo ticket
        TicketSvc --> API: {ticketId, status: "PENDING", message: "OK"}
        API --> Web: {ticketId, status: "PENDING", message: "OK"}
        Web --> Funcionario: Ticket creado exitosamente
    else Error en inserción
        DB --> TicketSvc: {error: "Error en base de datos"}
        TicketSvc --> API: {error: "Error al crear ticket", status: "ERROR"}
        API --> Web: {error: "Error al crear ticket", status: "ERROR"}
        Web --> Funcionario: Mostrar error "No se pudo crear el ticket"
    end
else Datos inválidos
    TicketSvc --> API: {error: "Datos del ticket inválidos", status: "ERROR"}
    API --> Web: {error: "Datos del ticket inválidos", status: "ERROR"}
    Web --> Funcionario: Mostrar error "Complete todos los campos requeridos"
end

== Asignación de Ticket ==
Administrador -> Web: Revisar tickets pendientes
Web -> API: GET /tickets?status=PENDING
API -> TicketSvc: obtenerTicketsPendientes()
TicketSvc -> DB: SELECT tickets WHERE status = 'PENDING'
DB --> TicketSvc: lista tickets

alt Tickets encontrados
    TicketSvc --> API: {tickets: [...], status: "OK"}
    API --> Web: {tickets: [...], status: "OK"}
    Web --> Administrador: Mostrar tickets

    alt Asignación Automática
        API -> TicketSvc: asignarAutomaticamente(ticketId)
        TicketSvc -> DB: SELECT tecnico WHERE disponibilidad = true
        alt Técnico disponible
            DB --> TicketSvc: tecnico disponible
            TicketSvc -> DB: UPDATE ticket SET tecnico_id = ?, status = 'ASSIGNED'
            alt Actualización exitosa
                DB --> TicketSvc: {rowsAffected: 1, status: "OK"}
                TicketSvc -> NotifSvc: notificarAsignacion(ticketId, tecnicoId)
                NotifSvc -> SMS: enviarSMS("Nuevo ticket asignado")
                SMS --> Tecnico: SMS de notificación
                NotifSvc -> Email: enviarEmail("Ticket asignado")
                Email --> Tecnico: Email de notificación
                TicketSvc --> API: {ticketId, tecnicoId, status: "ASSIGNED", message: "OK"}
                API --> Web: {ticketId, tecnicoId, status: "ASSIGNED", message: "OK"}
                Web --> Administrador: Ticket asignado exitosamente
            else Error en actualización
                DB --> TicketSvc: {error: "Error al actualizar ticket"}
                TicketSvc --> API: {error: "Error al asignar ticket", status: "ERROR"}
                API --> Web: {error: "Error al asignar ticket", status: "ERROR"}
                Web --> Administrador: Mostrar error "No se pudo asignar el ticket"
            end
        else No hay técnicos disponibles
            DB --> TicketSvc: null
            TicketSvc --> API: {error: "No hay técnicos disponibles", status: "ERROR"}
            API --> Web: {error: "No hay técnicos disponibles", status: "ERROR"}
            Web --> Administrador: Mostrar error "No hay técnicos disponibles"
        end
    else Asignación Manual
        Administrador -> Web: Seleccionar técnico
    Web -> API: PUT /tickets/{id}/assign
        API -> TicketSvc: asignarTicket(ticketId, tecnicoId)
        alt Técnico válido
            TicketSvc -> DB: UPDATE ticket SET tecnico_id = ?, status = 'ASSIGNED'
            alt Actualización exitosa
                DB --> TicketSvc: {rowsAffected: 1, status: "OK"}
                TicketSvc -> NotifSvc: notificarAsignacion(ticketId, tecnicoId)
                NotifSvc -> SMS: enviarSMS("Nuevo ticket asignado")
                SMS --> Tecnico: SMS de notificación
                NotifSvc -> Email: enviarEmail("Ticket asignado")
                Email --> Tecnico: Email de notificación
                TicketSvc --> API: {ticketId, tecnicoId, status: "ASSIGNED", message: "OK"}
                API --> Web: {ticketId, tecnicoId, status: "ASSIGNED", message: "OK"}
                Web --> Administrador: Ticket asignado exitosamente
            else Error en actualización
                DB --> TicketSvc: {error: "Error al actualizar ticket"}
                TicketSvc --> API: {error: "Error al asignar ticket", status: "ERROR"}
                API --> Web: {error: "Error al asignar ticket", status: "ERROR"}
                Web --> Administrador: Mostrar error "No se pudo asignar el ticket"
            end
        else Técnico inválido
            TicketSvc --> API: {error: "Técnico no válido", status: "ERROR"}
            API --> Web: {error: "Técnico no válido", status: "ERROR"}
            Web --> Administrador: Mostrar error "Técnico seleccionado no válido"
        end
    end
else No hay tickets pendientes
    DB --> TicketSvc: []
    TicketSvc --> API: {tickets: [], status: "OK"}
    API --> Web: {tickets: [], status: "OK"}
    Web --> Administrador: Mostrar mensaje "No hay tickets pendientes"
end

== Resolución de Ticket ==
Tecnico -> App: Ver tickets asignados
App -> API: GET /tickets/assigned
API -> TicketSvc: obtenerTicketsAsignados(tecnicoId)
TicketSvc -> DB: SELECT tickets WHERE tecnico_id = ? AND status = 'ASSIGNED'
DB --> TicketSvc: tickets asignados

alt Tickets encontrados
    TicketSvc --> API: {tickets: [...], status: "OK"}
    API --> App: {tickets: [...], status: "OK"}
    App --> Tecnico: Mostrar tickets

    Tecnico -> App: Seleccionar ticket para trabajar
App -> API: GET /tickets/{id}
    API -> TicketSvc: obtenerTicket(ticketId)
    TicketSvc -> DB: SELECT ticket WHERE id = ?
    alt Ticket encontrado
        DB --> TicketSvc: datos ticket
        TicketSvc --> API: {ticket: {...}, status: "OK"}
        API --> App: {ticket: {...}, status: "OK"}
        App --> Tecnico: Mostrar detalles del ticket

        Tecnico -> App: Cambiar estado a "En Progreso"
        App -> API: PATCH /tickets/{id}/status
        API -> TicketSvc: actualizarEstado(ticketId, "IN_PROGRESS")
        TicketSvc -> DB: UPDATE ticket SET status = 'IN_PROGRESS', fecha_inicio = NOW()
        alt Actualización exitosa
            DB --> TicketSvc: {rowsAffected: 1, status: "OK"}
            TicketSvc --> API: {status: "IN_PROGRESS", message: "OK"}
            API --> App: {status: "IN_PROGRESS", message: "OK"}
            App --> Tecnico: Estado actualizado a "En Progreso"
        else Error en actualización
            DB --> TicketSvc: {error: "Error al actualizar estado"}
            TicketSvc --> API: {error: "Error al actualizar estado", status: "ERROR"}
            API --> App: {error: "Error al actualizar estado", status: "ERROR"}
            App --> Tecnico: Mostrar error "No se pudo actualizar el estado"
        end

        Tecnico -> App: Subir evidencias
App -> API: POST /tickets/{id}/evidence
        API -> TicketSvc: agregarEvidencia(ticketId, archivo)
        alt Archivo válido
            TicketSvc -> DB: INSERT evidence
            alt Inserción exitosa
                DB --> TicketSvc: {evidenceId: 123, status: "OK"}
                TicketSvc --> API: {evidenceId: 123, message: "OK"}
                API --> App: {evidenceId: 123, message: "OK"}
                App --> Tecnico: Evidencia subida exitosamente
            else Error en inserción
                DB --> TicketSvc: {error: "Error al guardar evidencia"}
                TicketSvc --> API: {error: "Error al guardar evidencia", status: "ERROR"}
                API --> App: {error: "Error al guardar evidencia", status: "ERROR"}
                App --> Tecnico: Mostrar error "No se pudo subir la evidencia"
            end
        else Archivo inválido
            TicketSvc --> API: {error: "Archivo no válido", status: "ERROR"}
            API --> App: {error: "Archivo no válido", status: "ERROR"}
            App --> Tecnico: Mostrar error "Formato de archivo no válido"
        end

        Tecnico -> App: Marcar como resuelto
        App -> API: PATCH /tickets/{id}/resolve
        API -> TicketSvc: resolverTicket(ticketId, solucion)
        alt Solución válida
            TicketSvc -> DB: UPDATE ticket SET status = 'RESOLVED', solucion = ?, fecha_resolucion = NOW()
            alt Actualización exitosa
                DB --> TicketSvc: {rowsAffected: 1, status: "OK"}
                TicketSvc -> NotifSvc: notificarResolucion(ticketId)
                NotifSvc -> Email: enviarEmail("Ticket resuelto")
                Email --> Funcionario: Notificación de resolución
                TicketSvc --> API: {status: "RESOLVED", message: "OK"}
                API --> App: {status: "RESOLVED", message: "OK"}
                App --> Tecnico: Ticket resuelto exitosamente
            else Error en actualización
                DB --> TicketSvc: {error: "Error al resolver ticket"}
                TicketSvc --> API: {error: "Error al resolver ticket", status: "ERROR"}
                API --> App: {error: "Error al resolver ticket", status: "ERROR"}
                App --> Tecnico: Mostrar error "No se pudo resolver el ticket"
            end
        else Solución inválida
            TicketSvc --> API: {error: "Solución no válida", status: "ERROR"}
            API --> App: {error: "Solución no válida", status: "ERROR"}
            App --> Tecnico: Mostrar error "Complete la descripción de la solución"
        end
    else Ticket no encontrado
        DB --> TicketSvc: null
        TicketSvc --> API: {error: "Ticket no encontrado", status: "ERROR"}
        API --> App: {error: "Ticket no encontrado", status: "ERROR"}
        App --> Tecnico: Mostrar error "Ticket no encontrado"
    end
else No hay tickets asignados
    DB --> TicketSvc: []
    TicketSvc --> API: {tickets: [], status: "OK"}
    API --> App: {tickets: [], status: "OK"}
    App --> Tecnico: Mostrar mensaje "No hay tickets asignados"
end

== Evaluación y Cierre ==
Funcionario -> Web: Recibir notificación de resolución
Web -> API: GET /tickets/{id}
API -> TicketSvc: obtenerTicket(ticketId)
TicketSvc -> DB: SELECT ticket WHERE id = ?
alt Ticket encontrado
    DB --> TicketSvc: datos ticket
    TicketSvc --> API: {ticket: {...}, status: "OK"}
    API --> Web: {ticket: {...}, status: "OK"}
    Web --> Funcionario: Mostrar ticket resuelto

    Funcionario -> Web: Completar encuesta de satisfacción
Web -> API: POST /tickets/{id}/survey
    API -> TicketSvc: registrarEncuesta(ticketId, rating, comentario)
    alt Datos de encuesta válidos
        TicketSvc -> DB: INSERT satisfaction_survey
        alt Inserción exitosa
            DB --> TicketSvc: {surveyId: 456, status: "OK"}
            TicketSvc -> DB: UPDATE ticket SET status = 'CLOSED', fecha_cierre = NOW()
            alt Actualización exitosa
                DB --> TicketSvc: {rowsAffected: 1, status: "OK"}
                TicketSvc -> NotifSvc: notificarCierre(ticketId)
                NotifSvc -> Email: enviarEmail("Ticket cerrado")
                Email --> Tecnico: Notificación de cierre
                TicketSvc --> API: {status: "CLOSED", message: "OK"}
                API --> Web: {status: "CLOSED", message: "OK"}
                Web --> Funcionario: Ticket cerrado exitosamente
            else Error al cerrar ticket
                DB --> TicketSvc: {error: "Error al cerrar ticket"}
                TicketSvc --> API: {error: "Error al cerrar ticket", status: "ERROR"}
                API --> Web: {error: "Error al cerrar ticket", status: "ERROR"}
                Web --> Funcionario: Mostrar error "No se pudo cerrar el ticket"
            end
        else Error al guardar encuesta
            DB --> TicketSvc: {error: "Error al guardar encuesta"}
            TicketSvc --> API: {error: "Error al guardar encuesta", status: "ERROR"}
            API --> Web: {error: "Error al guardar encuesta", status: "ERROR"}
            Web --> Funcionario: Mostrar error "No se pudo guardar la encuesta"
        end
    else Datos de encuesta inválidos
        TicketSvc --> API: {error: "Datos de encuesta inválidos", status: "ERROR"}
        API --> Web: {error: "Datos de encuesta inválidos", status: "ERROR"}
        Web --> Funcionario: Mostrar error "Complete todos los campos de la encuesta"
    end
else Ticket no encontrado
    DB --> TicketSvc: null
    TicketSvc --> API: {error: "Ticket no encontrado", status: "ERROR"}
    API --> Web: {error: "Ticket no encontrado", status: "ERROR"}
    Web --> Funcionario: Mostrar error "Ticket no encontrado"
end

== Gestión de Usuarios (Super Administrador) ==
SuperAdministrador -> Web: Acceder a gestión de usuarios
Web -> API: GET /admin/users
API -> TicketSvc: obtenerUsuarios()
TicketSvc -> DB: SELECT usuarios
alt Usuarios encontrados
    DB --> TicketSvc: lista usuarios
    TicketSvc --> API: {usuarios: [...], status: "OK"}
    API --> Web: {usuarios: [...], status: "OK"}
    Web --> SuperAdministrador: Mostrar usuarios

    SuperAdministrador -> Web: Crear nuevo usuario
    Web -> API: POST /admin/users
    API -> TicketSvc: crearUsuario(datosUsuario)
    alt Datos de usuario válidos
        TicketSvc -> DB: SELECT usuario WHERE email = ?
        alt Email no existe
            DB --> TicketSvc: null
            TicketSvc -> DB: INSERT usuario
            alt Inserción exitosa
                DB --> TicketSvc: {usuarioId: 789, status: "OK"}
                TicketSvc -> NotifSvc: notificarNuevoUsuario(usuarioId)
                NotifSvc -> Email: enviarEmail("Cuenta creada")
                Email --> Funcionario: Credenciales de acceso
                TicketSvc --> API: {usuarioId: 789, message: "OK"}
                API --> Web: {usuarioId: 789, message: "OK"}
                Web --> SuperAdministrador: Usuario creado exitosamente
            else Error en inserción
                DB --> TicketSvc: {error: "Error al crear usuario"}
                TicketSvc --> API: {error: "Error al crear usuario", status: "ERROR"}
                API --> Web: {error: "Error al crear usuario", status: "ERROR"}
                Web --> SuperAdministrador: Mostrar error "No se pudo crear el usuario"
            end
        else Email ya existe
            DB --> TicketSvc: usuario existente
            TicketSvc --> API: {error: "Email ya existe", status: "ERROR"}
            API --> Web: {error: "Email ya existe", status: "ERROR"}
            Web --> SuperAdministrador: Mostrar error "El email ya está registrado"
        end
    else Datos de usuario inválidos
        TicketSvc --> API: {error: "Datos de usuario inválidos", status: "ERROR"}
        API --> Web: {error: "Datos de usuario inválidos", status: "ERROR"}
        Web --> SuperAdministrador: Mostrar error "Complete todos los campos requeridos"
    end
else No hay usuarios
    DB --> TicketSvc: []
    TicketSvc --> API: {usuarios: [], status: "OK"}
    API --> Web: {usuarios: [], status: "OK"}
    Web --> SuperAdministrador: Mostrar mensaje "No hay usuarios registrados"
end

@enduml
