@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #2E86AB
  FontColor #2E86AB
}
skinparam actor {
  BackgroundColor #FFE5B4
  BorderColor #FF8C00
  FontColor #FF8C00
}

title Casos de Uso: Técnico

left to right direction

actor "Técnico" as T

package "App Móvil" {
  usecase "Iniciar Sesión" as Login
  usecase "Ver Tickets" as VerTickets
  usecase "Resolver Ticket" as Resolver
  usecase "Registrar Evidencias" as Evidencias
  usecase "Ver Historial" as Historial
  usecase "2FA" as 2FA
  usecase "Recuperar Contraseña" as Recuperar
}

package "Notificaciones" {
  usecase "Push Notification" as Push
  usecase "SMS" as SMS
}

' === Relaciones ===
T --> Login
T --> VerTickets
T --> Resolver
T --> Evidencias
T --> Historial

' === Include ===
Resolver ..> Push : "<<include>>"
Evidencias ..> Push : "<<include>>"

' === Extend ===
Login ..> 2FA : "<<extend>>\n(opcional)"
Login ..> Recuperar : "<<extend>>\n(opcional)"
Push ..> SMS : "<<extend>>\n(opcional)"

@enduml
