@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #E8F4FD
  BorderColor #2E86AB
  FontColor #2E86AB
}
skinparam actor {
  BackgroundColor #FFE5B4
  BorderColor #FF8C00
  FontColor #FF8C00
}

title Casos de Uso: Funcionario

left to right direction

actor "Funcionario" as F

package "Portal Web" {
  usecase "Iniciar Sesión" as Login
  usecase "Crear Ticket" as CrearTicket
  usecase "Ver Mis Tickets" as VerTickets
  usecase "Evaluar Servicio" as Evaluar
  usecase "Ver Historial" as Historial
  usecase "2FA" as 2FA
  usecase "Recuperar Contraseña" as Recuperar
}

package "Notificaciones" {
  usecase "Recibir notificacion push" as Email
}

' === Relaciones ===
F --> Login
F --> CrearTicket
F --> VerTickets
F --> Evaluar
F --> Historial

' === Include ===
CrearTicket ..> Email : "<<include>>"
VerTickets ..> Email : "<<include>>"
Evaluar ..> Email : "<<include>>"

' === Extend ===
Login ..> 2FA : "<<extend>>\n(opcional)"
Login ..> Recuperar : "<<extend>>\n(opcional)"
VerTickets ..> Historial : "<<extend>>\n(opcional)"

@enduml