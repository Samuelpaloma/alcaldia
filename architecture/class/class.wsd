  + findById(id : Long) : Object
  + findAll() : List<Report>
  + deleteById(id : Long) : Boolean
  + update(entity : Report) : Report
  + findByType(reportType : String) : List<Report>
  + findByGeneratedBy(userId : Long) : List<Report>
  + findByPeriod(period : String) : List<Report>
}

' ========================
' Relationships with Labels
' ========================

' User Inheritance
BaseEntity <|-- BaseUser : extends
BaseUser <|-- User : extends
User <|-- Functionary : extends
User <|-- Technician : extends
User <|-- Administrator : extends
User <|-- SuperAdministrator : extends

' Interface Implementations
UserServiceImpl ..|> IUserService : implements
TicketServiceImpl ..|> ITicketService : implements
NotificationServiceImpl ..|> INotificationService : implements
ReportServiceImpl ..|> IReportService : implements

' Repository Implementations
UserRepository ..|> IRepository : implements
TicketRepository ..|> IRepository : implements
NotificationRepository ..|> IRepository : implements
EvidenceRepository ..|> IRepository : implements
CommentRepository ..|> IRepository : implements
SatisfactionSurveyRepository ..|> IRepository : implements
ReportRepository ..|> IRepository : implements

' Enum Relationships
User "1" -- "1" Role : has
Ticket "1" -- "1" TicketStatus : has
Notification "1" -- "1" NotificationType : has

' Ticket Relationships
Functionary "1" -- "0..*" Ticket : creates
Technician "1" -- "0..*" Ticket : assigned to
Ticket "1" -- "0..*" Evidence : contains
Ticket "1" -- "0..*" Comment : has
Ticket "1" -- "0..*" Notification : generates
Ticket "1" -- "0..1" SatisfactionSurvey : receives

' User Relationships
User "1" -- "0..*" Notification : receives
User "1" -- "0..*" SatisfactionSurvey : responds

' DTO Relationships
UserDTO ..> User : maps to
TicketDTO ..> Ticket : maps to
NotificationDTO ..> Notification : maps to

' Service Dependencies
IUserService ..> UserDTO : uses
ITicketService ..> TicketDTO : uses
INotificationService ..> NotificationDTO : uses
IReportService ..> Report : uses

' Service to Repository Dependencies
UserServiceImpl --> UserRepository : uses
TicketServiceImpl --> TicketRepository : uses
TicketServiceImpl --> UserRepository : uses
TicketServiceImpl --> INotificationService : uses
NotificationServiceImpl --> NotificationRepository : uses
ReportServiceImpl --> ReportRepository : uses
ReportServiceImpl --> TicketRepository : uses
ReportServiceImpl --> UserRepository : uses

@enduml
