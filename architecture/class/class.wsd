  + CommentRepository()
  + CommentRepository(entityManager : String)
  + save(entity : Comment) : Comment
  + findById(id : Long) : Object<Comment>
  + findAll() : List<Comment>
  + deleteById(id : Long) : Boolean
  + update(entity : Comment) : Comment
  + findByTicket(ticketId : Long) : List<Comment>
  + findByAuthor(userId : Long) : List<Comment>
  + findInternalComments(ticketId : Long) : List<Comment>
}

class SatisfactionSurveyRepository {
  - entityManager : String
  --
  + SatisfactionSurveyRepository()
