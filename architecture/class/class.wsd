  + EvidenceRepository()
  + EvidenceRepository(entityManager : String)
  + save(entity : Evidence) : Evidence
  + findById(id : Long) : Object<Evidence>
  + findAll() : List<Evidence>
  + deleteById(id : Long) : Boolean
  + update(entity : Evidence) : Evidence
  + findByTicket(ticketId : Long) : List<Evidence>
  + findByUploadedBy(userId : Long) : List<Evidence>
  + findByMimeType(mimeType : String) : List<Evidence>
}

class CommentRepository {
  - entityManager : String
