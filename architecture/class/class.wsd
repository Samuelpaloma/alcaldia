@startuml
!theme plain
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam class {
  BackgroundColor #E8F4FD
  BorderColor #2E86AB
  FontColor #2E86AB
}
skinparam interface {
  BackgroundColor #FFE5B4
  BorderColor #FF8C00
  FontColor #FF8C00
}
skinparam abstract {
  BackgroundColor #F0F8FF
  BorderColor #4169E1
  FontColor #4169E1
}
skinparam enum {
  BackgroundColor #F5F5DC
  BorderColor #DAA520
  FontColor #DAA520
}

title Sistema de Gestión de Tickets - Diagrama de Clases Completo

' ========================
' INTERFACES (Contratos)
' ========================
interface IUserService {
  + authenticate(credentials: String): Boolean
  + authorize(userId: Long, permission: String): Boolean
  + getProfile(userId: Long): UserDTO
  + updateProfile(userId: Long, data: UserDTO): Boolean
  + changePassword(userId: Long, oldPass: String, newPass: String): Boolean
}

interface ITicketService {
  + createTicket(ticketData: TicketDTO): Ticket
  + updateTicket(ticketId: Long, data: TicketDTO): Boolean
  + assignTicket(ticketId: Long, technicianId: Long): Boolean
  + closeTicket(ticketId: Long, solution: String): Boolean
  + getTicketById(ticketId: Long): Ticket
  + getTicketsByUser(userId: Long): List<Ticket>
}

interface INotificationService {
  + sendNotification(notification: NotificationDTO): Boolean
  + scheduleNotification(notification: NotificationDTO, scheduleTime: LocalDateTime): Boolean
  + markAsRead(notificationId: Long): Boolean
  + getNotificationsByUser(userId: Long): List<Notification>
  + deleteNotification(notificationId: Long): Boolean
}

interface IReportService {
  + generateReport(reportType: String, period: String): Report
  + exportReport(reportId: Long, format: String): String
  + scheduleReport(reportType: String, schedule: String): Boolean
  + getReportHistory(userId: Long): List<Report>
}

interface IRepository {
  + save(entity: Object): Object
  + findById(id: Long): Object
  + findAll(): List
  + deleteById(id: Long): Boolean
  + update(entity: Object): Object
}

' ========================
' CLASES ABSTRACTAS
' ========================
abstract class BaseEntity {
  - id: Long
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  - createdBy: String
  - updatedBy: String
  --
  + BaseEntity()
  + BaseEntity(id: Long, createdAt: LocalDateTime, updatedAt: LocalDateTime, createdBy: String, updatedBy: String)
  + getId(): Long
  + setId(id: Long): void
  + getCreatedAt(): LocalDateTime
  + setCreatedAt(createdAt: LocalDateTime): void
  + getUpdatedAt(): LocalDateTime
  + setUpdatedAt(updatedAt: LocalDateTime): void
  + getCreatedBy(): String
  + setCreatedBy(createdBy: String): void
  + getUpdatedBy(): String
  + setUpdatedBy(updatedBy: String): void
  {abstract} + validate(): Boolean
  {abstract} + toDTO(): Object
}

abstract class BaseUser {
  - name: String
  - email: String
  - passwordHash: String
  - isActive: Boolean
  - lastLogin: LocalDateTime
  --
  + BaseUser()
  + BaseUser(name: String, email: String, passwordHash: String, isActive: Boolean)
  + getName(): String
  + setName(name: String): void
  + getEmail(): String
  + setEmail(email: String): void
  + getPasswordHash(): String
  + setPasswordHash(passwordHash: String): void
  + getIsActive(): Boolean
  + setIsActive(isActive: Boolean): void
  + getLastLogin(): LocalDateTime
  + setLastLogin(lastLogin: LocalDateTime): void
  + login(credentials: String): Boolean
  + logout(): void
  + isAuthenticated(): Boolean
  {abstract} + hasPermission(permission: String): Boolean
  {abstract} + getRole(): String
}

' ========================
' DTOs (Data Transfer Objects)
' ========================
class UserDTO {
  - id : Long
  - name : String
  - email : String
  - role : String
  - isActive : Boolean
  - lastLogin : LocalDateTime
  - createdAt : LocalDateTime
  --
  + UserDTO()
  + UserDTO(id, name, email, role, isActive, lastLogin, createdAt)
  + getId() : Long
  + setId(id : Long) : void
  + getName() : String
  + setName(name : String) : void
  + getEmail() : String
  + setEmail(email : String) : void
  + getRole() : String
  + setRole(role : String) : void
  + getIsActive() : Boolean
  + setIsActive(isActive : Boolean) : void
  + getLastLogin() : LocalDateTime
  + setLastLogin(lastLogin : LocalDateTime) : void
  + getCreatedAt() : LocalDateTime
  + setCreatedAt(createdAt : LocalDateTime) : void
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class TicketDTO {
  - id : Long
  - title : String
  - description : String
  - priority : Integer
  - category : String
  - status : String
  - creationDate : LocalDateTime
  - closeDate : LocalDateTime
  - estimatedTime : Integer
  - actualTime : Integer
  - createdBy : Long
  - assignedTo : Long
  --
  + TicketDTO()
  + TicketDTO(id, title, description, priority, category, status, creationDate, closeDate, estimatedTime, actualTime, createdBy, assignedTo)
  + getId() : Long
  + setId(id : Long) : void
  + getTitle() : String
  + setTitle(title : String) : void
  + getDescription() : String
  + setDescription(description : String) : void
  + getPriority() : Integer
  + setPriority(priority : Integer) : void
  + getCategory() : String
  + setCategory(category : String) : void
  + getStatus() : String
  + setStatus(status : String) : void
  + getCreationDate() : LocalDateTime
  + setCreationDate(creationDate : LocalDateTime) : void
  + getCloseDate() : LocalDateTime
  + setCloseDate(closeDate : LocalDateTime) : void
  + getEstimatedTime() : Integer
  + setEstimatedTime(estimatedTime : Integer) : void
  + getActualTime() : Integer
  + setActualTime(actualTime : Integer) : void
  + getCreatedBy() : Long
  + setCreatedBy(createdBy : Long) : void
  + getAssignedTo() : Long
  + setAssignedTo(assignedTo : Long) : void
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class NotificationDTO {
  - id : Long
  - type : String
  - title : String
  - content : String
  - date : LocalDateTime
  - isRead : Boolean
  - recipientId : Long
  --
  + NotificationDTO()
  + NotificationDTO(id, type, title, content, date, isRead, recipientId)
  + getId() : Long
  + setId(id : Long) : void
  + getType() : String
  + setType(type : String) : void
  + getTitle() : String
  + setTitle(title : String) : void
  + getContent() : String
  + setContent(content : String) : void
  + getDate() : LocalDateTime
  + setDate(date : LocalDateTime) : void
  + getIsRead() : Boolean
  + setIsRead(isRead : Boolean) : void
  + getRecipientId() : Long
  + setRecipientId(recipientId : Long) : void
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

' ========================
' Enums
' ========================
enum Role {
  FUNCTIONARY
  TECHNICIAN
  ADMINISTRATOR
  SUPER_ADMINISTRATOR
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

enum NotificationType {
  EMAIL
  SMS
  IN_APP
  PUSH
}

' ========================
' Core User Domain
' ========================
class User {
  - role : Role
  - profilePicture : String = "default.jpg"
  - phoneNumber : String
  - address : String
  - department : String
  --
  + User()
  + User(name : String, email : String, passwordHash : String, role : Role)
  + User(name : String, email : String, passwordHash : String, role : Role, phoneNumber : String, address : String, department : String)
  + getRole() : Role
  + setRole(role : Role) : void
  + getProfilePicture() : String
  + setProfilePicture(profilePicture : String) : void
  + getPhoneNumber() : String
  + setPhoneNumber(phoneNumber : String) : void
  + getAddress() : String
  + setAddress(address : String) : void
  + getDepartment() : String
  + setDepartment(department : String) : void
  + editProfile(data : UserDTO) : void
  + changePassword(oldPass : String, newPass : String) : Boolean
  + hasPermission(permission : String) : Boolean
  + getRole() : String
  + validate() : Boolean
  + toDTO() : UserDTO
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class Functionary {
  - employeeId : String
  - position : String
  - hireDate : LocalDateTime
  - salary : Double
  - managerId : Long
  --
  + Functionary()
  + Functionary(employeeId : String, position : String, hireDate : LocalDateTime, salary : Double, managerId : Long)
  + getEmployeeId() : String
  + setEmployeeId(employeeId : String) : void
  + getPosition() : String
  + setPosition(position : String) : void
  + getHireDate() : LocalDateTime
  + setHireDate(hireDate : LocalDateTime) : void
  + getSalary() : Double
  + setSalary(salary : Double) : void
  + getManagerId() : Long
  + setManagerId(managerId : Long) : void
  + createTicket(ticketData : TicketDTO) : Ticket
  + viewMyTickets() : List<Ticket>
  + updateTicket(ticketId : Long, data : TicketDTO) : Boolean
  + evaluateService(ticketId : Long, rating : Integer) : Boolean
  + hasPermission(permission : String) : Boolean
  + getRole() : String
  + validate() : Boolean
  + toDTO() : UserDTO
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class Technician {
  - specialization : String
  - experience : Integer
  - workload : Integer = 0
  - certifications : List<String>
  - availability : Boolean = true
  - maxTickets : Integer = 10
  --
  + Technician()
  + Technician(specialization : String, experience : Integer, workload : Integer, certifications : List<String>)
  + getSpecialization() : String
  + setSpecialization(specialization : String) : void
  + getExperience() : Integer
  + setExperience(experience : Integer) : void
  + getWorkload() : Integer
  + setWorkload(workload : Integer) : void
  + getCertifications() : List<String>
  + setCertifications(certifications : List<String>) : void
  + getAvailability() : Boolean
  + setAvailability(availability : Boolean) : void
  + getMaxTickets() : Integer
  + setMaxTickets(maxTickets : Integer) : void
  + viewAssignedTickets() : List<Ticket>
  + updateTicketStatus(ticketId : Long, status : TicketStatus) : Boolean
  + addComment(ticketId : Long, comment : String) : Boolean
  + attachEvidence(ticketId : Long, evidence : Evidence) : Boolean
  + resolveTicket(ticketId : Long, solution : String) : Boolean
  + canAcceptTicket() : Boolean
  + hasPermission(permission : String) : Boolean
  + getRole() : String
  + validate() : Boolean
  + toDTO() : UserDTO
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class Administrator {
  - accessLevel : Integer = 1
  - permissions : List<String>
  - canManageUsers : Boolean = false
  - canViewReports : Boolean = true
  - canAssignTickets : Boolean = true
  --
  + Administrator()
  + Administrator(accessLevel : Integer, permissions : List<String>)
  + getAccessLevel() : Integer
  + setAccessLevel(accessLevel : Integer) : void
  + getPermissions() : List<String>
  + setPermissions(permissions : List<String>) : void
  + getCanManageUsers() : Boolean
  + setCanManageUsers(canManageUsers : Boolean) : void
  + getCanViewReports() : Boolean
  + setCanViewReports(canViewReports : Boolean) : void
  + getCanAssignTickets() : Boolean
  + setCanAssignTickets(canAssignTickets : Boolean) : void
  + generateReports(period : String, type : String) : List<Report>
  + viewDashboards() : List<Dashboard>
  + assignTickets() : Boolean
  + monitorPerformance() : List<Metric>
  + manageTechnicians() : List<Technician>
  + hasPermission(permission : String) : Boolean
  + getRole() : String
  + validate() : Boolean
  + toDTO() : UserDTO
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class SuperAdministrator {
  - systemAccess : Boolean = true
  - auditLevel : Integer = 3
  - systemPermissions : List<String>
  - canModifySystem : Boolean = true
  - canAccessAuditLogs : Boolean = true
  --
  + SuperAdministrator()
  + SuperAdministrator(systemAccess : Boolean, auditLevel : Integer, systemPermissions : List<String>)
  + getSystemAccess() : Boolean
  + setSystemAccess(systemAccess : Boolean) : void
  + getAuditLevel() : Integer
  + setAuditLevel(auditLevel : Integer) : void
  + getSystemPermissions() : List<String>
  + setSystemPermissions(systemPermissions : List<String>) : void
  + getCanModifySystem() : Boolean
  + setCanModifySystem(canModifySystem : Boolean) : void
  + getCanAccessAuditLogs() : Boolean
  + setCanAccessAuditLogs(canAccessAuditLogs : Boolean) : void
  + configureSystem(settings : String) : Boolean
  + manageUsers() : List<User>
  + manageRoles() : List<Role>
  + auditSystem() : String
  + backupSystem() : Boolean
  + hasPermission(permission : String) : Boolean
  + getRole() : String
  + validate() : Boolean
  + toDTO() : UserDTO
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

' ========================
' Core Ticket Domain
' ========================
class Ticket {
  - title : String
  - description : String
  - priority : Integer = 3
  - category : String
  - closeDate : LocalDateTime
  - status : TicketStatus = PENDING
  - estimatedTime : Integer = 0
  - actualTime : Integer = 0
  - createdBy : User
  - assignedTo : Technician
  - tags : List<String>
  - attachments : List<Evidence>
  - comments : List<Comment>
  - notifications : List<Notification>
  --
  + Ticket()
  + Ticket(title : String, description : String, priority : Integer, category : String, createdBy : User)
  + getTitle() : String
  + setTitle(title : String) : void
  + getDescription() : String
  + setDescription(description : String) : void
  + getPriority() : Integer
  + setPriority(priority : Integer) : void
  + getCategory() : String
  + setCategory(category : String) : void
  + getCloseDate() : LocalDateTime
  + setCloseDate(closeDate : LocalDateTime) : void
  + getStatus() : TicketStatus
  + setStatus(status : TicketStatus) : void
  + getEstimatedTime() : Integer
  + setEstimatedTime(estimatedTime : Integer) : void
  + getActualTime() : Integer
  + setActualTime(actualTime : Integer) : void
  + getCreatedBy() : User
  + setCreatedBy(createdBy : User) : void
  + getAssignedTo() : Technician
  + setAssignedTo(assignedTo : Technician) : void
  + getTags() : List<String>
  + setTags(tags : List<String>) : void
  + getAttachments() : List<Evidence>
  + setAttachments(attachments : List<Evidence>) : void
  + getComments() : List<Comment>
  + setComments(comments : List<Comment>) : void
  + getNotifications() : List<Notification>
  + setNotifications(notifications : List<Notification>) : void
  + updateStatus(newStatus : TicketStatus) : Boolean
  + assignTechnician(technicianId : Long) : Boolean
  + closeTicket(solution : String) : Boolean
  + reopenTicket(reason : String) : Boolean
  + addComment(comment : Comment) : Boolean
  + attachEvidence(evidence : Evidence) : Boolean
  + calculateSLA() : Integer
  + isOverdue() : Boolean
  + getTimeSpent() : Integer
  + validate() : Boolean
  + toDTO() : TicketDTO
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class Evidence {
  - id : Long
  - fileName : String
  - filePath : String
  - fileSize : Long
  - mimeType : String
  - uploadDate : LocalDateTime
  - uploadedBy : User
  - ticket : Ticket
  --
  + Evidence()
  + Evidence(fileName : String, filePath : String, fileSize : Long, mimeType : String, uploadedBy : User, ticket : Ticket)
  + getId() : Long
  + setId(id : Long) : void
  + getFileName() : String
  + setFileName(fileName : String) : void
  + getFilePath() : String
  + setFilePath(filePath : String) : void
  + getFileSize() : Long
  + setFileSize(fileSize : Long) : void
  + getMimeType() : String
  + setMimeType(mimeType : String) : void
  + getUploadDate() : LocalDateTime
  + setUploadDate(uploadDate : LocalDateTime) : void
  + getUploadedBy() : User
  + setUploadedBy(uploadedBy : User) : void
  + getTicket() : Ticket
  + setTicket(ticket : Ticket) : void
  + validateFile() : Boolean
  + compressFile() : Boolean
  + generateThumbnail() : String
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class Comment {
  - id : Long
  - text : String
  - date : LocalDateTime
  - author : User
  - isInternal : Boolean
  - isSystem : Boolean
  - ticket : Ticket
  --
  + Comment()
  + Comment(text : String, author : User, isInternal : Boolean, isSystem : Boolean, ticket : Ticket)
  + getId() : Long
  + setId(id : Long) : void
  + getText() : String
  + setText(text : String) : void
  + getDate() : LocalDateTime
  + setDate(date : LocalDateTime) : void
  + getAuthor() : User
  + setAuthor(author : User) : void
  + getIsInternal() : Boolean
  + setIsInternal(isInternal : Boolean) : void
  + getIsSystem() : Boolean
  + setIsSystem(isSystem : Boolean) : void
  + getTicket() : Ticket
  + setTicket(ticket : Ticket) : void
  + formatText() : String
  + notifyUsers() : Boolean
  + archiveComment() : Boolean
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class Notification {
  - id : Long
  - type : NotificationType
  - title : String
  - content : String
  - date : LocalDateTime
  - isRead : Boolean
  - recipient : User
  - ticket : Ticket
  --
  + Notification()
  + Notification(type : NotificationType, title : String, content : String, recipient : User, ticket : Ticket)
  + getId() : Long
  + setId(id : Long) : void
  + getType() : NotificationType
  + setType(type : NotificationType) : void
  + getTitle() : String
  + setTitle(title : String) : void
  + getContent() : String
  + setContent(content : String) : void
  + getDate() : LocalDateTime
  + setDate(date : LocalDateTime) : void
  + getIsRead() : Boolean
  + setIsRead(isRead : Boolean) : void
  + getRecipient() : User
  + setRecipient(recipient : User) : void
  + getTicket() : Ticket
  + setTicket(ticket : Ticket) : void
  + send() : Boolean
  + markAsRead() : Boolean
  + schedule() : Boolean
  + cancel() : Boolean
  + toDTO() : NotificationDTO
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

class SatisfactionSurvey {
  - id : Long
  - rating : Integer
  - comment : String
  - date : LocalDateTime
  - ticket : Ticket
  - respondent : User
  --
  + SatisfactionSurvey()
  + SatisfactionSurvey(rating : Integer, comment : String, ticket : Ticket, respondent : User)
  + getId() : Long
  + setId(id : Long) : void
  + getRating() : Integer
  + setRating(rating : Integer) : void
  + getComment() : String
  + setComment(comment : String) : void
  + getDate() : LocalDateTime
  + setDate(date : LocalDateTime) : void
  + getTicket() : Ticket
  + setTicket(ticket : Ticket) : void
  + getRespondent() : User
  + setRespondent(respondent : User) : void
  + calculateScore() : Double
  + generateReport() : String
  + archive() : Boolean
  + toString() : String
  + equals(obj : Object) : Boolean
  + hashCode() : int
}

' ========================
' SERVICE CLASSES (Implementaciones)
' ========================
class UserServiceImpl {
  - userRepository : UserRepository
  - passwordEncoder : String
  --
  + UserServiceImpl()
  + UserServiceImpl(userRepository : UserRepository, passwordEncoder : String)
  + authenticate(credentials : String) : Boolean
  + authorize(userId : Long, permission : String) : Boolean
  + getProfile(userId : Long) : UserDTO
  + updateProfile(userId : Long, data : UserDTO) : Boolean
  + changePassword(userId : Long, oldPass : String, newPass : String) : Boolean
}

class TicketServiceImpl {
  - ticketRepository : TicketRepository
  - userRepository : UserRepository
  - notificationService : INotificationService
  --
  + TicketServiceImpl()
  + TicketServiceImpl(ticketRepository : TicketRepository, userRepository : UserRepository, notificationService : INotificationService)
  + createTicket(ticketData : TicketDTO) : Ticket
  + updateTicket(ticketId : Long, data : TicketDTO) : Boolean
  + assignTicket(ticketId : Long, technicianId : Long) : Boolean
  + closeTicket(ticketId : Long, solution : String) : Boolean
  + getTicketById(ticketId : Long) : Ticket
  + getTicketsByUser(userId : Long) : List<Ticket>
}

class NotificationServiceImpl {
  - notificationRepository : NotificationRepository
  - emailService : String
  - smsService : String
  - pushService : String
  --
  + NotificationServiceImpl()
  + NotificationServiceImpl(notificationRepository : NotificationRepository, emailService : String, smsService : String, pushService : String)
  + sendNotification(notification : NotificationDTO) : Boolean
  + scheduleNotification(notification : NotificationDTO, scheduleTime : LocalDateTime) : Boolean
  + markAsRead(notificationId : Long) : Boolean
  + getNotificationsByUser(userId : Long) : List<Notification>
  + deleteNotification(notificationId : Long) : Boolean
}

class ReportServiceImpl {
  - reportRepository : ReportRepository
  - ticketRepository : TicketRepository
  - userRepository : UserRepository
  --
  + ReportServiceImpl()
  + ReportServiceImpl(reportRepository : ReportRepository, ticketRepository : TicketRepository, userRepository : UserRepository)
  + generateReport(reportType : String, period : String) : Report
  + exportReport(reportId : Long, format : String) : String
  + scheduleReport(reportType : String, schedule : String) : Boolean
  + getReportHistory(userId : Long) : List<Report>
}

' ========================
' ADDITIONAL CLASSES
' ========================
