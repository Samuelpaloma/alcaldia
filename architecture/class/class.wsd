' ========================
' REPOSITORY CLASSES
' ========================
class UserRepository {
  - entityManager : String
  --
  + UserRepository()
  + UserRepository(entityManager : String)
  + save(entity : User) : User
  + findById(id : Long) : Object<User>
  + findAll() : List<User>
  + deleteById(id : Long) : Boolean
  + update(entity : User) : User
  + findByEmail(email : String) : Object<User>
  + findByRole(role : Role) : List<User>
  + findActiveUsers() : List<User>
}

class TicketRepository {
  - entityManager : String
  --
  + TicketRepository()
  + TicketRepository(entityManager : String)
  + save(entity : Ticket) : Ticket
  + findById(id : Long) : Object<Ticket>
  + findAll() : List<Ticket>
  + deleteById(id : Long) : Boolean
  + update(entity : Ticket) : Ticket
  + findByStatus(status : TicketStatus) : List<Ticket>
  + findByAssignedTo(technicianId : Long) : List<Ticket>
  + findByCreatedBy(userId : Long) : List<Ticket>
  + findByPriority(priority : Integer) : List<Ticket>
}

class NotificationRepository {
  - entityManager : String
  --
  + NotificationRepository()
  + NotificationRepository(entityManager : String)
  + save(entity : Notification) : Notification
  + findById(id : Long) : Object<Notification>
  + findAll() : List<Notification>
  + deleteById(id : Long) : Boolean
  + update(entity : Notification) : Notification
  + findByRecipient(userId : Long) : List<Notification>
  + findByType(type : NotificationType) : List<Notification>
  + findUnreadByUser(userId : Long) : List<Notification>
}

class EvidenceRepository {
  - entityManager : String
