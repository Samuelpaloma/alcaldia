<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender para logs en consola -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender para logs de reportes específicos -->
    <appender name="REPORTS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/reports-debug.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/reports-debug.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Logger específico para reportes con nivel DEBUG -->
    <logger name="com.example.demo.reports" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="REPORTS_FILE"/>
    </logger>

    <!-- Logger para controladores con nivel INFO -->
    <logger name="com.example.demo.reports.controller" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="REPORTS_FILE"/>
    </logger>

    <!-- Logger raíz -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
